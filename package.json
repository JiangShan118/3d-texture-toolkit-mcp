{
  "name": "3d-texture-toolkit-mcp",
  "version": "0.1.0",
  "description": "Extract PBR texture maps from local GLB files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.JiangShan118/3d-texture-toolkit",
  "bin": {
    "3d-texture-toolkit-mcp": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/extract.js",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "pnpm build && tsx test/smoke.ts",
    "start": "node dist/index.js",
    "prepack": "pnpm build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
